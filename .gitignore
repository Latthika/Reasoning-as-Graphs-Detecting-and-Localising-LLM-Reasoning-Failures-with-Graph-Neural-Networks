# Data files — too large for GitHub, regenerate by running the notebooks
data/*.csv
data/*.npy
data/*.pt
data/*.json
data/*.png
data/*.txt

# Keep the data folder itself
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.ipynb_checkpoints/

# Jupyter
.jupyter/

# Environment
.env
*.env
venv/
.conda/

# API keys — never commit these
.groq_key
secrets.py

# OS files
.DS_Store
Thumbs.db

# Model weights — large files
*.pt
*.pth
*.bin

# Logs
*.log

# LaTeX build artefacts (keep main.pdf and main.tex; drop the rest)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/*.lof
paper/*.lot

# Old draft kept locally for reference, do not push
paper/_old_draft_v1.pdf
paper/.Rhistory
.Rhistory
